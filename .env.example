# Copy this file to .env and fill in real values.

# Local development uses a SQLite file. For production on a host without a
# persistent disk (e.g. Vercel) switch to Postgres: see README.md.
DATABASE_URL="file:./ribriz.db"

# Password for the admin panel at /admin. Use a long, unique password.
ADMIN_PASSWORD="change-me-to-a-long-password"

# Random secret used to sign the admin login cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-64-random-hex-characters"

# Public contact details shown on the site.
NEXT_PUBLIC_PHONE="1800 000 0000"
NEXT_PUBLIC_WHATSAPP="919800000000"
NEXT_PUBLIC_EMAIL="hello@ribriz.example"

# Full public URL of the site, used for sitemap and social previews.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
