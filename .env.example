# Copy this file to .env and fill in real values.

# Supabase Postgres. Copy both from Supabase dashboard -> Connect -> ORMs -> Prisma.
# DATABASE_URL uses the pooler (port 6543) for the app; DIRECT_URL (port 5432) is used
# for creating tables.
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Password for the admin panel at /admin. Use a long, unique password.
ADMIN_PASSWORD="change-me-to-a-long-password"

# Random secret used to sign the admin login cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-64-random-hex-characters"

# Public contact details shown on the site.
# Optional: WhatsApp Business number (digits only, with country code). Leave unset to hide WhatsApp links.
# NEXT_PUBLIC_WHATSAPP=""

# Full public URL of the site, used for sitemap and social previews.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase project (dashboard -> Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Server-only secret key, used to store admin photo uploads in Supabase Storage.
SUPABASE_SECRET_KEY=""

# Email (Resend: resend.com -> API Keys). Without a key, emails are printed in
# the server terminal during local development.
RESEND_API_KEY=""
# Sender address on your verified domain
EMAIL_FROM="Ribriz Travel <hello@notify.YOURDOMAIN.com>"
# Where new-enquiry alerts go (comma-separated)
TEAM_EMAIL=""
# Where customers' replies go. Set to hello@ribriztravel.com once that mailbox receives email.
# REPLY_TO=""
# Team members who can sign in to /admin with an email code (comma-separated)
ADMIN_EMAILS=""

# Protects the weekly visa-data refresh (Vercel sends it automatically). Any long random string.
CRON_SECRET=""

# Claude API key for the AI travel assistant (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=""

# Razorpay (https://dashboard.razorpay.com → Account & Settings → API keys).
# rzp_test_… keys for testing, rzp_live_… for real payments. The secret stays on the server.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhooks → https://www.ribriztravel.com/api/payments/webhook (payment.captured, payment.failed, refund.processed)
RAZORPAY_WEBHOOK_SECRET=""

# Push notifications (phone and browser). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@ribriztravel.com"
