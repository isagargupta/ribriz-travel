{
  "name": "ribriz-travel",
  "version": "1.0.0",
  "private": true,
  "description": "Ribriz Travel: holiday packages, group tours and hotels with an admin panel.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:push": "prisma db push && prisma db execute --file prisma/rls.sql --schema prisma/schema.prisma",
    "db:seed": "node --experimental-strip-types --no-warnings prisma/seed.ts",
    "setup": "npm run db:push && npm run db:seed",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test \"tests/**/*.test.ts\"",
    "e2e": "npm run build && playwright test",
    "e2e:quick": "playwright test",
    "check": "npm run typecheck && npm test && npm run e2e",
    "hooks": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@prisma/client": "^6.16.2",
    "@supabase/supabase-js": "^2.119.2",
    "next": "^16.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.16.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.6"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "effect": "^3.22.1"
  }
}
