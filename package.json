{
  "name": "ribriz-travel",
  "version": "1.0.0",
  "private": true,
  "description": "Ribriz Travel: holiday packages, group tours and hotels with an admin panel.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:seed": "node --experimental-strip-types --no-warnings prisma/seed.ts",
    "setup": "prisma db push && node --experimental-strip-types --no-warnings prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "prisma": "^6.16.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.6"
  }
}
