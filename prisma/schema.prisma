generator client {
  provider = "prisma-client-js"
}

// Supabase Postgres. DATABASE_URL goes through the connection pooler (app traffic);
// DIRECT_URL is a direct connection used when creating or changing tables.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Trip {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  dest        String
  country     String
  region      String
  /// package | escorted | hotel | cruise
  kind        String
  /// comma-separated: honeymoon,family,group,beach,heritage,nature,city,luxury
  themes      String
  nights      Int
  stars       Int
  /// RO | BB | HB | FB | AI
  board       String
  /// price per adult in INR, flights from Mumbai included when `flight` is true
  price       Int
  was         Int?
  rating      Float     @default(9)
  reviews     Int       @default(0)
  /// metres to the beach, null when not a beach stay
  beach       Int?
  flight      Boolean   @default(true)
  freeCancel  Boolean   @default(true)
  tourManager Boolean   @default(false)
  easyVisa    Boolean   @default(true)
  lastMinute  Boolean   @default(false)
  earlyBird   Boolean   @default(false)
  featured    Boolean   @default(false)
  published   Boolean   @default(true)
  image       String
  /// one highlight per line
  highlights  String
  /// one itinerary day per line
  days        String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  enquiries   Enquiry[]
  departures  Departure[]
}

/// A dated departure of a trip. Price = trip.price + priceDelta (+ city flight supplement).
model Departure {
  id         String    @id @default(cuid())
  tripId     String
  trip       Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  /// calendar date as YYYY-MM-DD (no time zone ambiguity)
  date       String
  /// per-adult price change versus the trip base price, in INR (can be negative)
  priceDelta Int       @default(0)
  /// seats or rooms left; null = not limited
  seatsLeft  Int?
  /// open | closed
  status     String    @default("open")
  enquiries  Enquiry[]

  @@unique([tripId, date])
  @@index([date])
}

model Enquiry {
  id          String     @id @default(cuid())
  /// short public reference customers quote, e.g. RB-7K2Q9M
  ref         String     @unique
  /// hold | enquiry | custom
  type        String
  name        String
  phone       String
  email       String
  tripId      String?
  trip        Trip?      @relation(fields: [tripId], references: [id], onDelete: SetNull)
  tripTitle   String?
  departureId String?
  dep         Departure? @relation(fields: [departureId], references: [id], onDelete: SetNull)
  departure   String?
  adults      Int        @default(2)
  children    Int        @default(0)
  /// JSON array of child ages
  childAges   String?
  /// JSON array of other traveller names
  travellers  String?
  fromCity    String?
  /// total in INR calculated on the server at the time of the request
  quotedTotal Int?
  message     String?
  /// new | contacted | booked | closed
  status      String     @default("new")
  note        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
