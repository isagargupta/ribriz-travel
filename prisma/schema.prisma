generator client {
  provider = "prisma-client-js"
}

// Supabase Postgres. DATABASE_URL goes through the connection pooler (app traffic);
// DIRECT_URL is a direct connection used when creating or changing tables.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Trip {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  dest        String
  country     String
  region      String
  /// package | escorted | hotel | cruise
  kind        String
  /// comma-separated: honeymoon,family,group,beach,heritage,nature,city,luxury
  themes      String
  nights      Int
  stars       Int
  /// RO | BB | HB | FB | AI
  board       String
  /// price per adult in INR, flights from Mumbai included when `flight` is true
  price       Int
  was         Int?
  rating      Float     @default(9)
  reviews     Int       @default(0)
  /// metres to the beach, null when not a beach stay
  beach       Int?
  flight      Boolean   @default(true)
  freeCancel  Boolean   @default(true)
  tourManager Boolean   @default(false)
  easyVisa    Boolean   @default(true)
  lastMinute  Boolean   @default(false)
  earlyBird   Boolean   @default(false)
  featured    Boolean   @default(false)
  published   Boolean   @default(true)
  image       String
  /// ISO 3166 two-letter codes of the countries visited, comma-separated (e.g. "CH,FR,IT")
  countryCodes String     @default("")
  /// team note shown above the automatic visa info (overrides it when set)
  visaNote    String?
  /// one highlight per line
  highlights  String
  /// one itinerary day per line
  days        String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  enquiries   Enquiry[]
  departures  Departure[]
}

/// A dated departure of a trip. Price = trip.price + priceDelta (+ city flight supplement).
model Departure {
  id         String    @id @default(cuid())
  tripId     String
  trip       Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  /// calendar date as YYYY-MM-DD (no time zone ambiguity)
  date       String
  /// per-adult price change versus the trip base price, in INR (can be negative)
  priceDelta Int       @default(0)
  /// seats or rooms left; null = not limited
  seatsLeft  Int?
  /// open | closed
  status     String    @default("open")
  enquiries  Enquiry[]

  @@unique([tripId, date])
  @@index([date])
}

model Enquiry {
  id          String     @id @default(cuid())
  /// short public reference customers quote, e.g. RB-7K2Q9M
  ref         String     @unique
  /// hold | enquiry | custom | visa | forex | insurance | flight | hotel
  type        String
  name        String
  phone       String
  email       String
  tripId      String?
  trip        Trip?      @relation(fields: [tripId], references: [id], onDelete: SetNull)
  tripTitle   String?
  departureId String?
  dep         Departure? @relation(fields: [departureId], references: [id], onDelete: SetNull)
  departure   String?
  adults      Int        @default(2)
  children    Int        @default(0)
  /// JSON array of child ages
  childAges   String?
  /// JSON array of other traveller names
  travellers  String?
  fromCity    String?
  /// total in INR calculated on the server at the time of the request
  quotedTotal Int?
  message     String?
  /// JSON with the service details (visa, forex, insurance, flight, hotel requests)
  details     String?
  missionId   String?
  mission     Mission?   @relation(fields: [missionId], references: [id], onDelete: SetNull)
  offers      ServiceOffer[]
  messages    TeamMessage[]
  /// new | contacted | booked | closed
  status      String     @default("new")
  note        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

/// A customer who has signed in with an email code. Their bookings are the
/// enquiries made with the same email address.
model Customer {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  phone       String?
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?
}

/// One-time sign-in codes. Only a keyed hash of the code is stored.
model LoginCode {
  id        String    @id @default(cuid())
  email     String
  /// customer | admin
  purpose   String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, purpose, createdAt])
}

/// Visa rule for holders of `passport` travelling to `destination` (ISO 3166 two-letter codes).
/// Source: Passport Index dataset (github.com/ilyankou/passport-index-dataset), synced weekly.
model VisaRule {
  passport    String
  destination String
  /// visa_free | voa | eta | evisa | required | own | no_entry
  category    String
  /// visa-free stay in days, when the source gives one
  days        Int?
  /// value exactly as published in the source
  raw         String

  @@id([passport, destination])
  @@index([passport, category])
}

/// When the visa data was last refreshed (single row, id = 1).
model VisaSync {
  id         Int      @id @default(1)
  /// date of the newest change in the source dataset
  sourceDate DateTime
  syncedAt   DateTime
  rows       Int
}

/// A traveller's trip, run by the agent from idea to departure.
model Mission {
  id            String         @id @default(cuid())
  /// signed-in owner; anonymous visitors are tracked by anonId until they sign in
  customerId    String?
  anonId        String?
  title         String
  /// what the traveller asked for, in their words
  goal          String
  /// planning | active | done | cancelled
  status        String         @default("planning")
  tripId        String?
  departureId   String?
  adults        Int            @default(2)
  childAges     String         @default("[]")
  fromCity      String         @default("Mumbai")
  passport      String         @default("IN")
  budgetPerAdult Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tasks         MissionTask[]
  approvals     Approval[]
  events        MissionEvent[]
  requests      Enquiry[]
  documents     TravelDoc[]

  @@index([customerId, updatedAt])
  @@index([anonId, updatedAt])
}

/// One step of a mission (choose trip, hold price, visa, insurance, forex, flights, hotels, documents).
model MissionTask {
  id        String   @id @default(cuid())
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  /// todo | in_progress | needs_approval | waiting | done | skipped
  status    String   @default("todo")
  /// short, traveller-facing note on where it stands
  note      String?
  /// JSON with results (trip chosen, reference numbers, …)
  data      String?
  order     Int      @default(0)
  dueDate   String?
  updatedAt DateTime @updatedAt

  @@unique([missionId, kind])
}

/// An action the agent prepared that only runs after the traveller approves it.
model Approval {
  id         String    @id @default(cuid())
  missionId  String?
  mission    Mission?  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  customerId String?
  anonId     String?
  /// price_hold | service_request
  action     String
  /// JSON input for the action, fixed at proposal time
  payload    String
  summary    String
  amountInr  Int?
  /// pending | approved | declined | expired | done | failed
  status     String    @default("pending")
  /// JSON result (reference, error)
  result     String?
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?
  expiresAt  DateTime

  @@index([missionId])
}

/// Timeline / audit trail of everything that happened on a mission.
model MissionEvent {
  id        String   @id @default(cuid())
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  /// agent | traveller | team | system
  actor     String
  message   String
  createdAt DateTime @default(now())

  @@index([missionId, createdAt])
}

/// A document a traveller uploaded for their visa. The file lives in the private
/// Supabase Storage bucket "visa-docs"; only signed, short-lived links are ever issued.
model TravelDoc {
  id          String    @id @default(cuid())
  missionId   String
  mission     Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  /// passport | photo | bank_statement | itr | employment_proof | cover_letter | insurance | flight_booking | hotel_booking | other
  kind        String
  fileKey     String    @unique
  fileName    String
  mime        String
  size        Int
  /// checking | ok | issue | unreadable
  status      String    @default("checking")
  /// JSON array of traveller-facing findings
  findings    String?
  /// JSON with the few fields we keep (e.g. passport expiry, holder name); never the full passport number
  extracted   String?
  createdAt   DateTime  @default(now())
  /// removed automatically after this date (30 days after the trip)
  deleteAfter DateTime?

  @@index([missionId, kind])
}

/// Something the background agents told a traveller (shown in the trip hub, sent by email).
model Notification {
  id         String    @id @default(cuid())
  customerId String?
  anonId     String?
  /// where it was sent
  email      String?
  missionId  String?
  /// price_drop | hold_expiring | hold_expired | visa_deadline | docs_missing | sold_out | pre_trip
  kind       String
  title      String
  body       String
  url        String?
  /// stops the same alert being created twice
  dedupeKey  String    @unique
  emailedAt  DateTime?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt])
  @@index([anonId, createdAt])
  @@index([email, emailedAt])
}

/// "Tell me if the price drops" on a trip (and optionally one date).
model PriceWatch {
  id          String   @id @default(cuid())
  customerId  String?
  anonId      String?
  email       String
  tripId      String
  /// a specific departure, or null for "any date around targetDate"
  departureId String?
  fromCity    String   @default("Mumbai")
  /// per-adult price when last checked, INR
  lastPrice   Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([email, tripId, departureId])
  @@index([active])
}

/// One run of the background agents, for the admin dashboard.
model AgentRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// JSON counts per detector, emails sent, errors
  stats      String?
  error      String?
}

/// People who asked not to receive reminder emails.
model EmailOptOut {
  email     String   @id
  createdAt DateTime @default(now())
}

/// An option the team (or later, a partner API) offers for a service request:
/// a flight, hotel, insurance plan or forex rate. The traveller picks one with
/// a one-tap approval; the team books it and records the confirmation.
model ServiceOffer {
  id           String    @id @default(cuid())
  enquiryId    String
  enquiry      Enquiry   @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  missionId    String?
  /// forex | insurance | flight | hotel | visa
  service      String
  title        String
  /// JSON array of short detail lines shown to the traveller
  lines        String    @default("[]")
  /// total in INR, when known
  priceInr     Int?
  validUntil   DateTime
  /// offered | chosen | declined | expired | booked | cancelled
  status       String    @default("offered")
  /// booking reference, PNR, policy or voucher number from the supplier
  confirmation String?
  bookedAt     DateTime?
  createdAt    DateTime  @default(now())

  @@index([enquiryId])
  @@index([missionId])
}

/// What Riya has learned about a traveller: lasting preferences and short notes.
/// One per account or browser; merged into the account on sign-in. The
/// traveller can see, edit and erase all of it at /you.
model TravellerProfile {
  id         String   @id @default(cuid())
  customerId String?  @unique
  anonId     String?  @unique
  /// JSON: { likes, avoid, regions, budgetPerAdult, months, pace, travelsWith, dietary }
  prefs      String   @default("{}")
  /// JSON array of { id, text, at }
  notes      String   @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// What the team sent a customer (email from the admin, or a WhatsApp message
/// opened from it) and internal notes, kept with the request.
model TeamMessage {
  id        String   @id @default(cuid())
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  /// email | whatsapp | note
  channel   String
  subject   String?
  body      String
  /// admin email, or "password"
  author    String
  /// true when Riya drafted it (edited or not)
  drafted   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([enquiryId, createdAt])
}
